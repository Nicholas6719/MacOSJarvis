<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>CFBundleDisplayName</key>
	<string>Jarvis</string>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<key>NSHumanReadableCopyright</key>
	<string>Local Jarvis Voice Assistant</string>
	<!-- Required so macOS shows the microphone permission prompt for this app.
	     The Python subprocess records audio, but TCC ties permission to the parent app. -->
	<key>LSUIElement</key>
	<true/>
	<key>NSMicrophoneUsageDescription</key>
	<string>Jarvis needs microphone access to hear your voice commands.</string>

	<!-- Calendar & Reminders access.
	     On macOS 14 (Sonoma) and later, apps get WRITE-ONLY calendar/reminder
	     access by default — they can create events but cannot read them. The
	     *FullAccessUsageDescription keys are what tell macOS the app needs
	     read access too, which triggers the "Full Access" permission prompt
	     instead of the "Write Only" default. The non-FullAccess keys are
	     kept for older macOS versions that use the legacy single-tier key.
	     Without these, "what's on my calendar this week?" returns an empty
	     list from AppleScript even though events clearly exist. -->
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>Jarvis needs full access to your calendar to read events when you ask what's on your schedule and to create events when you dictate a new one.</string>
	<key>NSCalendarsUsageDescription</key>
	<string>Jarvis needs calendar access to read your events and create new ones by voice.</string>
	<key>NSRemindersFullAccessUsageDescription</key>
	<string>Jarvis needs full access to your reminders to read your open reminders and create new ones by voice.</string>
	<key>NSRemindersUsageDescription</key>
	<string>Jarvis needs reminders access to read and create reminders by voice.</string>

	<!-- Allow plain HTTP/WS to localhost -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>
